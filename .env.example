# --- Google Gemini (free API key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Primary model and comma-separated fallbacks (used when a model is busy / rate limited)
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash

# --- PayPal REST app credentials (Sandbox) from https://developer.paypal.com/dashboard/applications/sandbox ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# SANDBOX (default) or PRODUCTION
PAYPAL_ENVIRONMENT=SANDBOX

# --- App ---
PORT=3000
